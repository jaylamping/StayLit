{
  "name": "staylit",
  "private": true,
  "version": "0.1.0",
  "description": "StayLit desktop hub for LIFX lights on the local network",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:ui": "tsc -p tsconfig.app.json --noEmit && vite build",
    "test": "npm test --prefix sidecar && node --experimental-strip-types --test ui/src/lib/edits.test.js",
    "build": "npm run build --prefix sidecar",
    "postinstall": "npm install --prefix sidecar"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
